{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "audit:evidence-migration": "pnpm --filter @workspace/scripts run audit:evidence-migration",
    "audit:campaign-migration": "pnpm --filter @workspace/scripts run audit:campaign-migration",
    "audit:knowledge-migration": "pnpm --filter @workspace/scripts run audit:knowledge-migration",
    "audit:output-migration": "pnpm --filter @workspace/scripts run audit:output-migration",
    "benchmark:platform": "pnpm --filter @workspace/scripts run benchmark:platform",
    "desktop": "pnpm --filter @workspace/ntech-c3 run desktop",
    "package:dir": "pnpm --filter @workspace/ntech-c3 run package:dir",
    "package:mac": "pnpm --filter @workspace/ntech-c3 run package:mac",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
